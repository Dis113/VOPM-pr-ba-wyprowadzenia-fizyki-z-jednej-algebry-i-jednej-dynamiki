def primitiveRoot (d : Fin 240) : Fin 8 → ℤ :=
  primitiveRoots.get d

/-- Genuine root-lattice coordinate shifts for a periodic E8 lattice. -/
def shift (n : ℕ) : Fin 240 → VOPM.UnitaryWalk.Site n :=
  fun d i => ((primitiveRoot d i : ℤ) : ZMod (n + 1))

/-- One prescribed nearest-neighbor step in the primitive root coordinates. -/
theorem neighbor_step (n : ℕ)
    (x : VOPM.UnitaryWalk.Site n) (d : Fin 240) :
    VOPM.UnitaryWalk.DirectedNeighbor (shift n) x (x + shift n d) := by
  exact ⟨d, rfl⟩

end VOPM.E8Basis
