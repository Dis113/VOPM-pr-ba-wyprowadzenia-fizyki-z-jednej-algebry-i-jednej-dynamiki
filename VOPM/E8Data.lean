/-- The integer coordinates of twice a standard E₈ root. -/
def doubledRoot (d : Fin 240) : Fin 8 → ℤ :=
  doubledRoots.get d

/--
Make a periodic direction table by reducing each integer coordinate modulo
N=n+1. This uses the **known root coordinates** but does not assert the
periodic graph itself is an exact E₈ lattice quotient.
-/
def rootShift (n : ℕ) : Fin 240 → UnitaryWalk.Site n :=
  fun d i => ((doubledRoot d i : ℤ) : ZMod (n + 1))

/-- Concrete one-step walker with the standard E₈ root displacements. -/
def step {n : ℕ} (C : UnitaryWalk.LocalCoin)
    (ψ : UnitaryWalk.Wave n) : UnitaryWalk.Wave n :=
  UnitaryWalk.coinedTick (rootShift n) C ψ

/--
Every scalar product is preserved when the chosen eight-component local
coin is inner-product preserving.
-/
theorem step_pairing {n : ℕ} (C : UnitaryWalk.LocalCoin)
    (hC : UnitaryWalk.PreservesCoinPairing C)
    (ψ φ : UnitaryWalk.Wave n) :
    UnitaryWalk.pairing (step C ψ) (step C φ) =
      UnitaryWalk.pairing ψ φ := by
  exact UnitaryWalk.coinedTick_pairing (rootShift n) C hC ψ φ

end VOPM.E8Data
